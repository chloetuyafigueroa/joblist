<project name="Joblist" default="war" basedir=".">

    <property name="src.dir" value="src"/>
    <property name="web.dir" value="WebContent"/>
    <property name="build.root" value="build"/>
    <property name="build.dir" value="${build.root}/classes"/>
    <property name="dist.dir" value="dist"/>
    <property name="war.file" value="${dist.dir}/Joblist.war"/>

    <target name="clean">
        <delete dir="${build.root}"/>
        <delete dir="${dist.dir}"/>
    </target>

    <target name="compile">
        <mkdir dir="${build.dir}"/>

        <javac
            srcdir="${src.dir}"
            destdir="${build.dir}"
            includeantruntime="false"
            source="1.8"
            target="1.8"
            encoding="UTF-8"
            debug="true"
            failonerror="true">

            <classpath>
                <fileset dir="${web.dir}/WEB-INF/lib">
                    <include name="*.jar"/>
                    <exclude name="servlet-api*.jar"/>
                    <exclude name="javax.servlet-api*.jar"/>
                    <exclude name="jsp-api*.jar"/>
                </fileset>
            </classpath>
        </javac>

        <!-- Copy non-Java files such as properties, JSON, XML, and certificates -->
        <copy todir="${build.dir}">
            <fileset dir="${src.dir}">
                <exclude name="**/*.java"/>
            </fileset>
        </copy>
    </target>

    <target name="war" depends="clean,compile">
        <mkdir dir="${dist.dir}"/>

        <war
            destfile="${war.file}"
            webxml="${web.dir}/WEB-INF/web.xml">

            <fileset dir="${web.dir}">
                <!-- web.xml is already supplied through the webxml attribute -->
                <exclude name="WEB-INF/web.xml"/>

                <!-- Do not deploy container-provided servlet libraries -->
                <exclude name="WEB-INF/lib/servlet-api*.jar"/>
                <exclude name="WEB-INF/lib/javax.servlet-api*.jar"/>
                <exclude name="WEB-INF/lib/jsp-api*.jar"/>
            </fileset>

            <classes dir="${build.dir}"/>
        </war>

        <echo message="Created WAR: ${war.file}"/>
    </target>

</project>